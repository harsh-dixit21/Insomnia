# Local mode works without paid services. Never commit your .env.
INSOMNIA_PORT=5181
INSOMNIA_HOST=127.0.0.1
INSOMNIA_LOCAL_SERVICES=true
# Development SSO starts only on loopback; generated credentials: .data/local-sso.json.
INSOMNIA_LOCAL_SSO=true
INSOMNIA_SSO_PORT=5182
# Install Ollama, then: ollama pull qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Omit OLLAMA_MODEL to use explicitly labeled local evidence retrieval.
# IOMETE_SQLALCHEMY_URL=iomete://USER:ENCODED_TOKEN@HOST:443/spark_catalog/default?cluster=COMPUTE&data_plane=PLANE
# INSOMNIA_PYTHON=C:/path/to/virtualenv/Scripts/python.exe
# TAVILY_API_KEY=your-search-key
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-mail-user
# SMTP_PASSWORD=your-mail-password
# SMTP_FROM=Insomnia <noreply@your-domain.example>
# OIDC_ISSUER=https://your-identity-provider.example/realms/organization
# OIDC_CLIENT_ID=insomnia
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_LABEL=Organization SSO
# INSOMNIA_DB=C:/path/to/persistent/insomnia.sqlite
# Set both values when serving behind an HTTPS reverse proxy:
# INSOMNIA_ORIGIN=https://your-domain.example
# INSOMNIA_SECURE_COOKIE=true
# For production: INSOMNIA_LOCAL_SERVICES=false and INSOMNIA_LOCAL_SSO=false.
# Register SSO callback: https://your-domain.example/api/auth/sso/callback
