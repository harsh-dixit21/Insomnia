# Optional local configuration. No external API keys are required.
INSOMNIA_PORT=5181
INSOMNIA_HOST=127.0.0.1
# INSOMNIA_DB=C:/path/to/persistent/insomnia.sqlite
# Set both values when serving behind an HTTPS reverse proxy:
# INSOMNIA_ORIGIN=https://your-domain.example
# INSOMNIA_SECURE_COOKIE=true
