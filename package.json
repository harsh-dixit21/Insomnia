{
  "name": "insomnia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types server/index.mjs --dev",
    "build": "tsc -b && vite build",
    "preview": "npm start",
    "test": "node --experimental-strip-types --test tests/insomnia.test.ts tests/workbench.test.ts tests/backend.test.mjs tests/login.test.ts tests/login-routing.test.mjs tests/services.test.mjs",
    "check:screens": "node scripts/check-screens.mjs",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.mjs",
    "check:production": "node --experimental-strip-types scripts/check-production.mjs",
    "backup": "node --env-file-if-exists=.env --experimental-strip-types scripts/backup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jose": "^6.2.14",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=24.11.0"
