{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/gateway.mjs": { "maxDuration": 120, "includeFiles": "src/lib/**/*.ts" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?__path=:path*" },
    { "source": "/portal", "destination": "/portal/index.html" },
    { "source": "/portal/", "destination": "/portal/index.html" }
  ],
  "headers": [
    { "source": "/docs/insomnia-documentation.pdf", "headers": [
      { "key": "Content-Type", "value": "application/pdf" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] }
  ]
}
